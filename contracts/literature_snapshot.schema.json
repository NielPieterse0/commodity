{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://commodity.local/contracts/literature-snapshot/v1",
  "title": "Commodity Literature Snapshot",
  "type": "object", "additionalProperties": false,
  "required": ["schema_version","snapshot_id","research_question","search_scope","sources","claim_map","expected_observations","disconfirming_observations"],
  "properties": {
    "schema_version": {"const": 1}, "snapshot_id": {"type":"string","minLength":1},
    "research_question": {"type":"string","minLength":1}, "search_scope": {"type":"string","minLength":1},
    "sources": {"type":"array","minItems":2,"items":{"type":"object","additionalProperties":false,"required":["source_id","title","source_type","quality","locator"],"properties":{"source_id":{"type":"string","minLength":1},"title":{"type":"string","minLength":1},"source_type":{"enum":["peer_reviewed","academic_working_paper","government","exchange","standards_body","reputable_institution"]},"quality":{"enum":["primary","high"]},"locator":{"type":"string","minLength":1},"year":{"type":["integer","null"]}}}},
    "claim_map": {"type":"array","minItems":1,"items":{"type":"object","additionalProperties":false,"required":["claim","source_ids"],"properties":{"claim":{"type":"string","minLength":1},"source_ids":{"type":"array","minItems":1,"uniqueItems":true,"items":{"type":"string","minLength":1}}}}},
    "expected_observations": {"type":"array","minItems":1,"items":{"type":"string","minLength":1}},
    "disconfirming_observations": {"type":"array","minItems":1,"items":{"type":"string","minLength":1}}
  }
}
