{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://commodity.local/contracts/programme-evidence/v1",
  "title": "Commodity Programme Evidence and Feasibility Map",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "programme_id", "mission", "current_scan_id", "refresh_triggers", "research_lines", "feasibility_map", "semantics"],
  "properties": {
    "schema_version": {"const": 1},
    "programme_id": {"type": "string", "minLength": 1},
    "mission": {"type": "string", "minLength": 1},
    "current_scan_id": {"type": "string", "minLength": 1},
    "previous_scan_id": {"type": ["string", "null"]},
    "retrospective_synthesis": {"type": "object", "required": ["as_of", "purpose", "historical_fact_rule", "state_rule"], "additionalProperties": false, "properties": {"as_of": {"type": "string", "minLength": 1}, "purpose": {"type": "string", "minLength": 1}, "historical_fact_rule": {"type": "string", "minLength": 1}, "state_rule": {"type": "string", "minLength": 1}}},
    "refresh_triggers": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "research_lines": {"type": "array", "minItems": 1, "items": {"type": "object"}},
    "current_helicopter_view": {"type": "object", "required": ["known", "repeatedly_failed", "mechanisms_still_alive", "missing_not_negative", "integrated_system_needs", "next_branch_reason"], "additionalProperties": false, "properties": {"known": {"type": "array", "items": {"type": "string"}}, "repeatedly_failed": {"type": "array", "items": {"type": "string"}}, "mechanisms_still_alive": {"type": "array", "items": {"type": "string"}}, "missing_not_negative": {"type": "array", "items": {"type": "string"}}, "integrated_system_needs": {"type": "array", "items": {"type": "string"}}, "next_branch_reason": {"type": "string", "minLength": 1}}},
    "feasibility_map": {"type": "array", "minItems": 1, "items": {"type": "object", "required": ["target", "horizon", "information_family", "scientific_mepi", "raw_information", "effective_information_method", "detectable_effect", "expected_snr", "costs", "feasibility"], "properties": {"target": {"type": "string"}, "horizon": {"type": "string"}, "information_family": {"type": "string"}, "scientific_mepi": {"type": ["number", "object", "null"]}, "economic_mepi": {"type": ["number", "object", "null"]}, "raw_information": {"type": "number"}, "effective_information_method": {"type": "object"}, "detectable_effect": {"type": ["number", "null"]}, "expected_snr": {"type": ["number", "null"]}, "costs": {"type": "object"}, "market_implied_benchmark_required": {"type": "boolean"}, "hold_reason": {"type": "string"}, "feasibility": {"enum": ["go", "redesign", "hold", "stop"]}}}},
    "reopening_gates": {"type": "object", "additionalProperties": false, "properties": {"volatility": {"type": "object", "additionalProperties": false, "required": ["status", "mepi_relative_qlike", "current_daily_binding_ratio", "current_event_binding_ratio", "current_best_ratio", "release_threshold_ratio", "material_design_change_present", "fresh_confirmation_path_proven", "evidence_ref"], "properties": {"status": {"enum": ["hold", "released", "retired"]}, "mepi_relative_qlike": {"type": "number", "exclusiveMinimum": 0}, "current_daily_binding_ratio": {"type": "number", "minimum": 0}, "current_event_binding_ratio": {"type": "number", "minimum": 0}, "current_best_ratio": {"type": "number", "minimum": 0}, "release_threshold_ratio": {"type": "number", "exclusiveMinimum": 0}, "material_design_change_present": {"type": "boolean"}, "fresh_confirmation_path_proven": {"type": "boolean"}, "evidence_ref": {"type": "string", "minLength": 1}}}}},
    "semantics": {"type": "object"}
  }
}
