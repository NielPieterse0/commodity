{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://commodity.local/contracts/ng_market_truth.schema.json",
  "title": "Development-only NG market truth source attestation",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "evidence_class",
    "protected_confirmation_accessed",
    "dataset",
    "product_code",
    "max_trade_date",
    "inputs"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "evidence_class": {
      "const": "development"
    },
    "protected_confirmation_accessed": {
      "const": false
    },
    "dataset": {
      "const": "GLBX.MDP3"
    },
    "product_code": {
      "const": "NG"
    },
    "max_trade_date": {
      "type": "string",
      "format": "date",
      "pattern": "^20(0[0-9]|1[0-9]|2[0-2])-[0-9]{2}-[0-9]{2}$"
    },
    "inputs": {
      "type": "object",
      "required": [
        "definitions",
        "bars",
        "statistics"
      ],
      "additionalProperties": false,
      "properties": {
        "definitions": {
          "$ref": "#/$defs/definitionInput"
        },
        "bars": {
          "$ref": "#/$defs/barInput"
        },
        "statistics": {
          "$ref": "#/$defs/statisticInput"
        }
      }
    }
  },
  "$defs": {
    "input": {
      "type": "object",
      "required": [
        "relative_path",
        "sha256",
        "schema",
        "row_count"
      ],
      "additionalProperties": false,
      "properties": {
        "relative_path": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_.-]+\\.csv$"
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "schema": {
          "type": "string"
        },
        "row_count": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "definitionInput": {
      "allOf": [
        {
          "$ref": "#/$defs/input"
        },
        {
          "properties": {
            "schema": {
              "const": "definition"
            }
          }
        }
      ]
    },
    "barInput": {
      "allOf": [
        {
          "$ref": "#/$defs/input"
        },
        {
          "properties": {
            "schema": {
              "const": "ohlcv-1d"
            }
          }
        }
      ]
    },
    "statisticInput": {
      "allOf": [
        {
          "$ref": "#/$defs/input"
        },
        {
          "properties": {
            "schema": {
              "const": "statistics"
            }
          }
        }
      ]
    }
  }
}
