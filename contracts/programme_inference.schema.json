{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://commodity.local/contracts/programme-inference/v1",
  "title": "Commodity Programme Inference Ledger",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "zoom_level",
    "programme_id",
    "entries",
    "family_inference"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "programme_id": {
      "type": "string",
      "minLength": 1
    },
    "entries": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "entry_id",
          "programme_test_id",
          "family_id",
          "research_line_id",
          "experiment_id",
          "mode",
          "target",
          "horizon",
          "information_family",
          "model_family",
          "primary_metric",
          "windows_touched",
          "sealed_window_history",
          "exploratory_ancestry",
          "outcome",
          "influenced_later_design"
        ],
        "properties": {
          "entry_id": {
            "type": "string",
            "minLength": 1
          },
          "programme_test_id": {
            "type": "string",
            "minLength": 1
          },
          "family_id": {
            "type": "string",
            "minLength": 1
          },
          "research_line_id": {
            "type": "string",
            "minLength": 1
          },
          "experiment_id": {
            "type": "string",
            "minLength": 1
          },
          "mode": {
            "enum": [
              "confirmatory",
              "exploratory"
            ]
          },
          "target": {
            "type": "string"
          },
          "horizon": {
            "type": "string"
          },
          "information_family": {
            "type": "string"
          },
          "model_family": {
            "type": "string"
          },
          "primary_metric": {
            "type": "string"
          },
          "windows_touched": {
            "type": "array"
          },
          "sealed_window_history": {
            "type": "array"
          },
          "exploratory_ancestry": {
            "type": "array"
          },
          "outcome": {
            "type": [
              "string",
              "null"
            ]
          },
          "influenced_later_design": {
            "type": "boolean"
          },
          "governance_generation": {
            "enum": ["legacy_pre_15_step", "current_15_step"]
          },
          "source_record": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "family_inference": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "family_id",
          "procedure",
          "inputs_sha256",
          "implementation_ref",
          "result"
        ],
        "properties": {
          "family_id": {
            "type": "string",
            "minLength": 1
          },
          "procedure": {
            "enum": [
              "white_reality_check",
              "hansen_spa",
              "model_confidence_set",
              "benjamini_hochberg",
              "justified_alternative"
            ]
          },
          "inputs_sha256": {
            "type": "string",
            "pattern": "^[0-9a-fA-F]{64}$"
          },
          "implementation_ref": {
            "type": "string",
            "minLength": 1
          },
          "result": {
            "type": "object"
          },
          "justification": {
            "type": "string"
          }
        }
      }
    },
    "zoom_level": {
      "const": "L1"
    }
  }
}
