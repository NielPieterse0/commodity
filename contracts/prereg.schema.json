{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://commodity.local/contracts/prereg/v1",
  "title": "Commodity Confirmatory Preregistration",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "zoom_level",
    "experiment_id",
    "programme_id",
    "research_line_id",
    "slice_id",
    "orientation",
    "evidence_scan_ref",
    "literature_snapshot_ref",
    "parent_question",
    "uncertainty_reduced",
    "outside_scope",
    "mechanism",
    "hypotheses",
    "expectations",
    "post_result_triangulation",
    "mepi",
    "forecast",
    "datasets",
    "dependence",
    "power",
    "features",
    "model",
    "evaluation",
    "inference_ledger_entry_id",
    "sealed_window",
    "coherence_triggers",
    "outcome_logic",
    "permitted_human_dispositions",
    "reproduction",
    "lineage"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "experiment_id": {
      "type": "string",
      "minLength": 1
    },
    "programme_id": {
      "type": "string",
      "minLength": 1
    },
    "research_line_id": {
      "type": "string",
      "minLength": 1
    },
    "slice_id": {
      "type": "string",
      "minLength": 1
    },
    "orientation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "big_picture_ref",
        "where_this_fits",
        "origin_refs",
        "programme_question"
      ],
      "properties": {
        "big_picture_ref": {
          "const": "docs/big-picture.md"
        },
        "where_this_fits": {
          "type": "string",
          "minLength": 1
        },
        "origin_refs": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "programme_question": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "evidence_scan_ref": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "sha256",
        "scan_id"
      ],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-fA-F]{64}$"
        },
        "scan_id": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "literature_snapshot_ref": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "sha256"
      ],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-fA-F]{64}$"
        }
      }
    },
    "parent_question": {
      "type": "string",
      "minLength": 1
    },
    "uncertainty_reduced": {
      "type": "string",
      "minLength": 1
    },
    "outside_scope": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "mechanism": {
      "type": "string",
      "minLength": 1
    },
    "hypotheses": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "h0",
        "h1"
      ],
      "properties": {
        "h0": {
          "type": "string",
          "minLength": 1
        },
        "h1": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "expectations": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "expected",
        "disconfirming"
      ],
      "properties": {
        "expected": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "disconfirming": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "post_result_triangulation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "required",
        "independent_search_required"
      ],
      "properties": {
        "required": {
          "const": true
        },
        "independent_search_required": {
          "const": true
        }
      }
    },
    "mepi": {
      "type": "object",
      "minProperties": 1
    },
    "forecast": {
      "type": "object"
    },
    "datasets": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "vintage",
          "split_id",
          "role"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "vintage": {
            "type": "string",
            "minLength": 1
          },
          "split_id": {
            "type": "string",
            "minLength": 1
          },
          "role": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "dependence": {
      "type": "object"
    },
    "power": {
      "type": "object"
    },
    "features": {
      "type": "object",
      "required": [
        "definition_id",
        "preprocessing_id",
        "information_families"
      ],
      "properties": {
        "definition_id": {
          "type": "string",
          "minLength": 1
        },
        "preprocessing_id": {
          "type": "string",
          "minLength": 1
        },
        "information_families": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "model": {
      "type": "object",
      "required": [
        "family",
        "configuration_id",
        "training_rules"
      ],
      "properties": {
        "family": {
          "type": "string",
          "minLength": 1
        },
        "configuration_id": {
          "type": "string",
          "minLength": 1
        },
        "training_rules": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "evaluation": {
      "type": "object",
      "required": [
        "claim_scope",
        "market_implied_relevant",
        "primary_metric",
        "secondary_metrics",
        "inference_procedure",
        "programme_inference_procedure",
        "statistical_family",
        "candidate_family",
        "benchmarks"
      ],
      "properties": {
        "claim_scope": {
          "enum": [
            "forecasting",
            "volatility",
            "descriptive_mechanism",
            "trading_usefulness"
          ]
        },
        "market_implied_relevant": {
          "type": "boolean"
        },
        "primary_metric": {
          "type": "string",
          "minLength": 1
        },
        "secondary_metrics": {
          "type": "array"
        },
        "inference_procedure": {
          "type": "string",
          "minLength": 1
        },
        "programme_inference_procedure": {
          "enum": [
            "white_reality_check",
            "hansen_spa",
            "model_confidence_set",
            "benjamini_hochberg",
            "none"
          ]
        },
        "statistical_family": {
          "type": "string",
          "minLength": 1
        },
        "candidate_family": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "benchmarks": {
          "type": "array",
          "minItems": 1
        }
      }
    },
    "inference_ledger_entry_id": {
      "type": "string",
      "minLength": 1
    },
    "sealed_window": {
      "type": "object",
      "properties": {
        "sealed_window_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "use": {
          "enum": [
            "none",
            "confirmatory"
          ]
        },
        "dataset_id": {
          "type": "string"
        },
        "start": {
          "type": "string"
        },
        "end": {
          "type": "string"
        },
        "content_sha256": {
          "type": "string",
          "pattern": "^[0-9a-fA-F]{64}$"
        }
      }
    },
    "coherence_triggers": {
      "type": "array",
      "minItems": 2,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "direction",
          "metric",
          "operator",
          "threshold"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "direction": {
            "enum": [
              "unexpectedly_good",
              "unexpectedly_bad",
              "both"
            ]
          },
          "metric": {
            "type": "string"
          },
          "operator": {
            "enum": [
              "eq",
              "gte",
              "lte",
              "gt",
              "lt"
            ]
          },
          "threshold": {
            "type": [
              "number",
              "string",
              "boolean",
              "null"
            ]
          }
        }
      }
    },
    "outcome_logic": {
      "type": "object"
    },
    "permitted_human_dispositions": {
      "type": "array",
      "uniqueItems": true,
      "minItems": 6,
      "maxItems": 6,
      "items": {
        "enum": [
          "advance",
          "replicate",
          "refine",
          "branch",
          "hold",
          "stop"
        ]
      }
    },
    "reproduction": {
      "type": "object",
      "required": [
        "mode",
        "tolerance",
        "lockfile_identity",
        "runtime_identity",
        "model_checkpoint_identity",
        "hardware_sensitive_facts"
      ],
      "properties": {
        "mode": {
          "enum": [
            "logical",
            "byte"
          ]
        },
        "tolerance": {
          "type": "object"
        },
        "lockfile_identity": {
          "type": "string",
          "minLength": 1
        },
        "runtime_identity": {
          "type": "string",
          "minLength": 1
        },
        "model_checkpoint_identity": {
          "type": "string",
          "minLength": 1
        },
        "hardware_sensitive_facts": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "command_spec_sha256": {
          "type": "string",
          "pattern": "^[0-9a-fA-F]{64}$"
        },
        "output_filename": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "lineage": {
      "type": "object",
      "properties": {
        "supersedes_prereg_sha256": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "type": "string",
              "pattern": "^[0-9a-fA-F]{64}$"
            }
          ]
        },
        "supersedes_prereg_path": {
          "type": "string"
        },
        "amendment_reason": {
          "type": "string"
        },
        "exploratory_ancestry": {
          "type": "array"
        },
        "programme_ref": {
          "type": "string",
          "pattern": "^research/programmes/[0-9]{3}-[a-z0-9-]+/programme\\.json$"
        },
        "research_line_ref": {
          "type": "string",
          "pattern": "^research/programmes/[0-9]{3}-[a-z0-9-]+/lines/[0-9]{3}-[a-z0-9-]+/line\\.json$"
        },
        "predecessor_experiment_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "successor_experiment_ids": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "additionalProperties": false,
      "required": [
        "programme_ref",
        "research_line_ref",
        "predecessor_experiment_id",
        "successor_experiment_ids",
        "supersedes_prereg_sha256",
        "supersedes_prereg_path",
        "amendment_reason",
        "exploratory_ancestry"
      ]
    },
    "zoom_level": {
      "const": "L3"
    }
  }
}
