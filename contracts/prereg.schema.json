{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://commodity.local/contracts/prereg/v1",
  "title": "Commodity Confirmatory Preregistration",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "experiment_id", "programme_id", "research_line_id", "slice_id", "evidence_scan_ref", "literature_snapshot_ref", "parent_question", "uncertainty_reduced", "outside_scope", "mechanism", "hypotheses", "mepi", "forecast", "datasets", "dependence", "power", "features", "model", "evaluation", "inference_ledger_entry_id", "sealed_window", "coherence_triggers", "outcome_logic", "permitted_human_dispositions", "reproduction", "lineage"],
  "properties": {
    "schema_version": {"const": 1},
    "experiment_id": {"type": "string", "minLength": 1},
    "programme_id": {"type": "string", "minLength": 1},
    "research_line_id": {"type": "string", "minLength": 1},
    "slice_id": {"type": "string", "minLength": 1},
    "evidence_scan_ref": {"type": "string", "minLength": 1},
    "literature_snapshot_ref": {"type": "string", "minLength": 1},
    "parent_question": {"type": "string", "minLength": 1},
    "uncertainty_reduced": {"type": "string", "minLength": 1},
    "outside_scope": {"type": "array", "items": {"type": "string"}},
    "mechanism": {"type": "string", "minLength": 1},
    "hypotheses": {"type": "object", "additionalProperties": false, "required": ["h0", "h1"], "properties": {"h0": {"type": "string", "minLength": 1}, "h1": {"type": "string", "minLength": 1}}},
    "mepi": {"type": "object", "minProperties": 1},
    "forecast": {"type": "object"},
    "datasets": {"type": "array", "minItems": 1},
    "dependence": {"type": "object"},
    "power": {"type": "object"},
    "features": {"type": "object"},
    "model": {"type": "object"},
    "evaluation": {"type": "object", "required": ["claim_scope", "market_implied_relevant", "primary_metric", "secondary_metrics", "inference_procedure", "statistical_family", "benchmarks"], "properties": {"claim_scope": {"enum": ["forecasting", "volatility", "trading_usefulness"]}, "market_implied_relevant": {"type": "boolean"}, "primary_metric": {"type": "string", "minLength": 1}, "secondary_metrics": {"type": "array"}, "inference_procedure": {"type": "string", "minLength": 1}, "statistical_family": {"type": "string", "minLength": 1}, "benchmarks": {"type": "array", "minItems": 1}}},
    "inference_ledger_entry_id": {"type": "string", "minLength": 1},
    "sealed_window": {"type": "object"},
    "coherence_triggers": {"type": "array", "minItems": 2, "items": {"type": "object", "additionalProperties": false, "required": ["id", "direction"], "properties": {"id": {"type": "string", "minLength": 1}, "direction": {"enum": ["unexpectedly_good", "unexpectedly_bad", "both"]}}}},
    "outcome_logic": {"type": "object"},
    "permitted_human_dispositions": {"type": "array", "uniqueItems": true, "minItems": 6, "maxItems": 6, "items": {"enum": ["advance", "replicate", "refine", "branch", "hold", "stop"]}},
    "reproduction": {"type": "object"},
    "lineage": {"type": "object"}
  }
}
