{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ml-research-core.local/contracts/experiment/v2",
  "title": "ML Research Experiment Record",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "experiment_id", "run_id", "project", "hypothesis",
    "forecast", "datasets", "split", "features", "model", "training",
    "evaluation", "controls", "results", "decision", "lineage"
  ],
  "properties": {
    "schema_version": {"type": "integer", "const": 2},
    "experiment_id": {"type": "string", "minLength": 1},
    "run_id": {"type": "string", "minLength": 1},
    "project": {"type": "string", "minLength": 1},
    "hypothesis": {"type": "string", "minLength": 1},
    "forecast": {
      "type": "object", "additionalProperties": false,
      "required": ["target", "horizon", "prediction_timestamp_semantics", "target_timestamp_semantics", "information_cutoff_semantics"],
      "properties": {
        "target": {"type": "string", "minLength": 1},
        "horizon": {"type": "string", "minLength": 1},
        "prediction_timestamp_semantics": {"type": "string", "minLength": 1},
        "target_timestamp_semantics": {"type": "string", "minLength": 1},
        "information_cutoff_semantics": {"type": "string", "minLength": 1}
      }
    },
    "datasets": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["role", "id", "version", "sha256", "as_of", "vintage"],
        "properties": {
          "role": {"type": "string", "enum": ["train", "validation", "test", "evaluation", "auxiliary"]},
          "id": {"type": "string", "minLength": 1},
          "version": {"type": "string", "minLength": 1},
          "sha256": {"type": "string", "pattern": "^[0-9a-fA-F]{64}$"},
          "as_of": {"type": "string", "format": "date-time"},
          "vintage": {"type": "string", "minLength": 1}
        }
      }
    },
    "split": {
      "type": "object", "additionalProperties": false,
      "required": ["strategy", "train", "validation", "test"],
      "properties": {
        "strategy": {"type": "string", "minLength": 1},
        "seed": {"type": ["integer", "null"]},
        "train": {"$ref": "#/$defs/period"},
        "validation": {"$ref": "#/$defs/nullablePeriod"},
        "test": {"$ref": "#/$defs/period"}
      }
    },
    "features": {
      "type": "object", "additionalProperties": false,
      "required": ["definition_id", "definition_sha256", "preprocessing_id", "preprocessing_sha256"],
      "properties": {
        "definition_id": {"type": "string", "minLength": 1},
        "definition_sha256": {"type": "string", "pattern": "^[0-9a-fA-F]{64}$"},
        "preprocessing_id": {"type": "string", "minLength": 1},
        "preprocessing_sha256": {"type": "string", "pattern": "^[0-9a-fA-F]{64}$"}
      }
    },
    "model": {
      "type": "object", "additionalProperties": false,
      "required": ["family", "architecture", "configuration_id"],
      "properties": {
        "family": {"type": "string", "minLength": 1},
        "architecture": {"type": "string", "minLength": 1},
        "configuration_id": {"type": "string", "minLength": 1},
        "checkpoint": {"type": ["string", "null"]},
        "checkpoint_sha256": {"type": ["string", "null"], "pattern": "^[0-9a-fA-F]{64}$"}
      }
    },
    "training": {
      "type": "object", "additionalProperties": false,
      "required": ["seeds", "hyperparameters"],
      "properties": {
        "seeds": {"type": "array", "minItems": 1, "items": {"type": "integer"}},
        "hyperparameters": {"type": "object"},
        "epochs": {"type": ["integer", "null"], "minimum": 0},
        "duration_seconds": {"type": ["number", "null"], "minimum": 0}
      }
    },
    "evaluation": {
      "type": "object", "additionalProperties": false,
      "required": ["primary_metric", "metrics", "baselines"],
      "properties": {
        "primary_metric": {"type": "string", "minLength": 1},
        "metrics": {"type": "object", "minProperties": 1},
        "baselines": {
          "type": "array", "minItems": 1,
          "items": {"$ref": "#/$defs/baseline"}
        }
      }
    },
    "controls": {
      "type": "object", "additionalProperties": false,
      "required": ["leakage_check", "reproducibility_runs"],
      "properties": {
        "leakage_check": {"type": "string", "enum": ["passed", "failed", "incomplete", "not-applicable"]},
        "permutation_test": {"type": ["object", "null"]},
        "multiple_testing": {"type": ["object", "null"]},
        "reproducibility_runs": {"type": "integer", "minimum": 1}
      }
    },
    "results": {
      "type": "object", "additionalProperties": false,
      "required": ["primary_metric_value"],
      "properties": {
        "primary_metric_value": {"type": "number"},
        "uncertainty": {"type": ["object", "null"]},
        "significance": {"type": ["object", "null"]},
        "stability": {"type": ["object", "null"]}
      }
    },
    "decision": {
      "type": "object", "additionalProperties": false,
      "required": ["disposition", "rationale", "scope"],
      "properties": {
        "disposition": {"type": "string", "enum": ["reject", "repeat", "modify", "promote"]},
        "rationale": {"type": "string", "minLength": 1},
        "scope": {"type": "string", "const": "research_only"}
      }
    },
    "lineage": {
      "type": "object", "additionalProperties": false,
      "required": ["code_revision", "environment", "artifacts"],
      "properties": {
        "code_revision": {
          "type": "object", "additionalProperties": false,
          "required": ["commit_sha", "working_tree_dirty", "working_tree_diff_sha256"],
          "properties": {
            "commit_sha": {"type": ["string", "null"], "minLength": 1},
            "working_tree_dirty": {"type": "boolean"},
            "working_tree_diff_sha256": {
              "type": ["string", "null"], "pattern": "^[0-9a-fA-F]{64}$"
            }
          }
        },
        "environment": {"$ref": "#/$defs/environment"},
        "artifacts": {
          "type": "array",
          "items": {"$ref": "#/$defs/artifact"}
        }
      }
    }
  },
  "$defs": {
    "period": {
      "type": "object", "additionalProperties": false,
      "required": ["start", "end"],
      "properties": {
        "start": {"type": "string", "format": "date-time"},
        "end": {"type": "string", "format": "date-time"}
      }
    },
    "nullablePeriod": {
      "anyOf": [
        {"type": "null"},
        {"$ref": "#/$defs/period"}
      ]
    },
    "baseline": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "type", "configuration_id"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "type": {"type": "string", "minLength": 1},
        "configuration_id": {"type": "string", "minLength": 1}
      }
    },
    "artifact": {
      "type": "object", "additionalProperties": false,
      "required": ["role", "uri", "sha256"],
      "properties": {
        "role": {"type": "string", "minLength": 1},
        "uri": {"type": "string", "minLength": 1},
        "sha256": {"type": "string", "pattern": "^[0-9a-fA-F]{64}$"}
      }
    },
    "environment": {
      "type": "object", "additionalProperties": false,
      "required": ["runtime", "runtime_version", "dependency_lock_sha256", "hardware_id"],
      "properties": {
        "runtime": {"type": "string", "minLength": 1},
        "runtime_version": {"type": "string", "minLength": 1},
        "dependency_lock_sha256": {"type": "string", "pattern": "^[0-9a-fA-F]{64}$"},
        "hardware_id": {"type": "string", "minLength": 1}
      }
    }
  }
}
