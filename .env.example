# Free EIA Open Data API key. Never commit the real value.
EIA_API_KEY=

# Saxo Developer Portal 24-hour SIM token. Never commit the real value.
SAXO_SIM_ACCESS_TOKEN=

# Short-lived Saxo LIVE OAuth access token for read-only entitlement/capability probes.
# Do not use this variable as a substitute for a production OAuth refresh flow.
SAXO_LIVE_ACCESS_TOKEN=

# Massive Futures API key for canonical per-contract price-history ingestion. Never commit the real value.
MASSIVE_API_KEY=

# Databento historical market-data API key for bounded provider evaluation. Never commit the real value.
DATABENTO_API_KEY=

# Supabase S3-compatible development raw archive. Never commit the real access keys.
SUPABASE_ENDPOINT=https://qbugfnuzjbmdtgrqznxw.storage.supabase.co/storage/v1/s3
SUPABASE_REGION=eu-central-1
SUPABASE_NAME=commodity_s3
SUPABASE_ACCESS_KEY_ID=
SUPABASE_ACCESS_KEY=

# Provider-neutral archive settings consumed by Commodity.
COMMODITY_RAW_DEV_S3_BUCKET=commodity-raw-development
COMMODITY_RAW_DEV_S3_PROVIDER=supabase_storage_s3
COMMODITY_RAW_DEV_S3_PREFIX=raw