{
  "schema_version": 3,
  "target": "CME Henry Hub Natural Gas futures",
  "providers": {
    "eia_api_v2": {
      "api_base": "https://api.eia.gov/v2",
      "env_key": "EIA_API_KEY"
    },
    "eia_bulk": {
      "dataset_url_template": "https://www.eia.gov/opendata/bulk/{dataset_id}.zip",
      "access": "public_http"
    },
    "cftc_public_reporting": {
      "api_base": "https://publicreporting.cftc.gov/resource"
    },
    "saxo_openapi_sim": {
      "api_base": "https://gateway.saxobank.com/sim/openapi",
      "env_key": "SAXO_SIM_ACCESS_TOKEN",
      "read_only": true
    },
    "open_meteo_historical_forecast": {
      "api_base": "https://historical-forecast-api.open-meteo.com/v1/forecast",
      "single_runs_api_base": "https://single-runs-api.open-meteo.com/v1/forecast",
      "access": "http_json_no_key",
      "role": "historical_issued_forecast_candidate"
    },
    "noaa_gfs_archive": {
      "access": "public_archive",
      "role": "historical_issued_forecast_fallback"
    },
    "massive_futures": {
      "api_base": "https://api.massive.com",
      "env_key": "MASSIVE_API_KEY",
      "access": "authorization_bearer",
      "minimum_request_interval_seconds": 12.5,
      "snapshot_store": "data/raw/snapshots/massive",
      "documented_history_by_plan": {
        "basic": "2y",
        "starter": "2y",
        "developer": "5y",
        "advanced": "7+y"
      },
      "account_history_observed_as_of": "2026-08-12"
    }
  },
  "canonical_contract_schema": {
    "grain": "one row per trade_date and contract_id",
    "required_columns": ["trade_date", "contract_id", "expiration", "settle"],
    "optional_columns": ["open", "high", "low", "close", "volume", "open_interest", "available_at"],
    "timestamp_columns": ["trade_date", "expiration", "available_at"],
    "unique_key": ["trade_date", "contract_id"],
    "required_metadata": ["source_id", "source_sha256", "retrieved_at", "exchange", "product_code", "session_timezone", "calendar", "price_semantics"],
    "term_structure_price": "settle",
    "continuous_contract": {
      "status": "derived_only",
      "authoritative_storage": "raw_per_contract",
      "adjustment_method": "none_stored_raw",
      "default_roll_policy": "volume_crossover_dte_v1",
      "roll_policy_owner": "config/assumptions.json#assumptions.continuous_series_policy",
      "cross_contract_returns_allowed": false
    }
  },
  "sources": {
    "market_bootstrap": {
      "provider": "yfinance",
      "symbol": "NG=F",
      "status": "research_bootstrap",
      "purpose": "daily OHLCV proxy",
      "authoritative_for_execution": false
    },
    "market_canonical": {
      "provider": "massive_futures",
      "product_code": "NG",
      "status": "history_and_roll_validated_licensing_blocked",
      "purpose": "expiry-aware NYMEX NG per-contract settlement/OHLCV history",
      "preservation_status": "resumable_snapshot_capture_ready",
      "v1_curve_preservation": "M1-M12",
      "schedule_route": "futures/v1/schedules",
      "backtest_evidence_allowed": false,
      "approved_for_contract_price_history": true,
      "provides_contract_id": true,
      "provides_expiration": true,
      "provides_settlement": true,
      "historical_volume": true,
      "historical_open_interest": false,
      "history_depth_status": "verified_observed_boundary",
      "account_history_validated": true,
      "history_earliest_verified_trade_date": "2024-08-13",
      "history_validated_at_utc": "2026-08-12T20:05:00Z",
      "non_display_backtesting_rights_verified": false,
      "redistribution_allowed": false,
      "account_validation_manifest": "docs/development/canonical-roll-policy-and-history-validation/account-validation.json"
    },
    "saxo_henry_hub_probe": {
      "provider": "saxo_openapi_sim",
      "status": "sim_verification_pending",
      "purpose": "verify Henry Hub futures-space identity and historical chart depth",
      "search_keywords": "Henry Hub Natural Gas",
      "asset_type": "ContractFutures",
      "chart_horizon_minutes": 1440,
      "provides_contract_id": true,
      "provides_expiration": true,
      "provides_settlement": false,
      "price_semantics": "chart_last_traded_ohlc",
      "canonical_market_source": false,
      "backtest_evidence_allowed": false
    },
    "eia_nymex_prompt_history": {
      "provider": "eia_api_v2",
      "route": "natural-gas/pri/fut",
      "status": "historical_term_structure_candidate",
      "purpose": "daily NYMEX prompt-contract closes for contract ranks 1-4",
      "coverage_end": "2024-04-05",
      "provides_contract_id": false,
      "canonical_market_source": false
    },
    "eia_storage": {
      "provider": "eia_api_v2",
      "route": "natural-gas/stor/wkly",
      "bulk_dataset": "NG",
      "status": "capture_ready_current_snapshot_only",
      "point_in_time_required": true,
      "regular_release_semantics": "Thursday 10:30 America/New_York; holiday exceptions override",
      "historical_release_exceptions_required": true,
      "revision_snapshots_required": true,
      "availability_reconstruction_status": "historical_exceptions_incomplete"
    },
    "eia_fundamentals": {
      "provider": "eia_api_v2",
      "bulk_dataset": "NG",
      "routes": ["natural-gas/prod", "natural-gas/cons", "natural-gas/move", "natural-gas/pri"],
      "status": "capture_ready_current_snapshot_only",
      "point_in_time_required": true,
      "purpose": "production, balance, gas demand, LNG/pipeline trade and Henry Hub spot/reference price",
      "availability_reconstruction_status": "historical_release_vintages_incomplete"
    },
    "eia_power": {
      "provider": "eia_api_v2",
      "status": "targeted_snapshot_ready",
      "routes": ["electricity/rto/region-data", "electricity/rto/fuel-type-data"],
      "respondent": "US48",
      "demand_types": ["D", "DF"],
      "natural_gas_fueltype": "NG",
      "point_in_time_required": true,
      "purpose": "Lower-48 hourly demand/day-ahead demand forecast and natural-gas generation",
      "availability_reconstruction_status": "historical_revisions_incomplete"
    },
    "cftc_cot": {
      "provider": "cftc_public_reporting",
      "dataset": "72hh-3qpy",
      "contract_market_code": "023651",
      "status": "snapshot_ready_backtest_release_time_pending",
      "purpose": "weekly disaggregated Henry Hub positioning; Managed Money is the preferred research slice",
      "point_in_time_required": true,
      "regular_release_semantics": "Friday 15:30 America/New_York; holiday exceptions override",
      "report_as_of_semantics": "prior Tuesday under the regular schedule",
      "variant_decision": "futures-only versus futures-and-options-combined remains explicit",
      "availability_reconstruction_status": "historical_release_calendar_incomplete"
    },
    "weather": {
      "provider": "open_meteo_historical_forecast",
      "status": "single_runs_adapter_ready",
      "fallback_provider": "noaa_gfs_archive",
      "product": "actually-issued historical forecast",
      "model": "ecmwf_ifs",
      "archive_start": "2024-01-01",
      "point_in_time_required": true,
      "purpose": "forecast-vintage temperatures and HDD/CDD surprises by gas-demand region",
      "required_vintage_fields": ["issued_at", "available_at", "forecast_valid_at"],
      "forbidden_substitute": "reanalysis_as_forecast",
      "availability_reconstruction_status": "actual_source_availability_unresolved"
    }
  }
}
