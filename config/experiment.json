{
  "schema_version": 1,
  "experiment_id": "ng-next-session-return-baseline-v1",
  "hypothesis": "Daily market state and seasonality improve next-session return forecasts versus a zero-return benchmark.",
  "target": {
    "name": "next_session_log_return",
    "horizon_sessions": 1,
    "information_cutoff": "after_current_daily_bar_close"
  },
  "walk_forward": {
    "initial_train_rows": 756,
    "retrain_every_rows": 5
  },
  "research_period": {
    "start": "2010-01-01",
    "end": "2100-01-01",
    "end_semantics": "open_ended_far_future_sentinel"
  },
  "dataset": {
    "dataset_id": "us-ng-v1-pit",
    "evidence_mode": "research_pit",
    "leakage_enforcement": "pit_dataset_contract",
    "required_feature_families": [
      "market", "market_structure", "storage", "weather", "power",
      "positioning", "calendar_seasonality"
    ],
    "promotion_completeness": "full_v1"
  },
  "tournament": {
    "models": ["naive", "ridge", "hist_gb"],
    "primary_metric": "rmse",
    "split_strategy": "expanding_walk_forward"
  },
  "controls": {
    "leakage_check": "incomplete",
    "reproducibility_runs": 1
  },
  "decision": {
    "disposition": "repeat",
    "rationale": "Run the leakage-safe PIT core tournament now; full-V1 promotion still requires every configured feature family to become PIT-admissible."
  }
}
