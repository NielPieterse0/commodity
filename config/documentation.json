{
  "schema_version": 2,
  "generator": "scripts/docs/generate_docs.py",
  "pages": [
    {
      "path": "docs/README.md",
      "kind": "repository_index",
      "sources": [
        "config/documentation_authority.json",
        "AGENTS.md"
      ]
    },
    {
      "path": "docs/big-picture.md",
      "kind": "repository_big_picture",
      "sources": [
        "AGENTS.md"
      ]
    },
    {
      "path": "docs/data-platform.md",
      "kind": "data_platform",
      "sources": [
        "config/data_platform.json",
        "contracts/data_platform.schema.json",
        "contracts/raw_artifact_manifest.schema.json",
        "data/manifests/ng-phase1-atlas.json",
        "data/manifests/ng-phase1-feature-registry.json",
        "data/manifests/phase1-benchmark.json",
        "data/manifests/phase1-cost-ledger.json",
        "data/manifests/phase1-catalog-validation.json",
        "data/manifests/raw-artifacts.json"
      ]
    },
    {
      "path": "docs/data-manifest.md",
      "kind": "data_architecture",
      "sources": [
        "config/data_sources.json",
        "config/research_dataset.json",
        "data/acquisition-recipes/*.json"
      ]
    },
    {
      "path": "docs/research-methodology.md",
      "kind": "research_methodology",
      "sources": [
        "config/research_methodology.json",
        "config/research_dataset.json",
        "contracts/*.schema.json"
      ]
    },
    {
      "path": "docs/quantitative-research-knowledge.md",
      "kind": "quantitative_research_knowledge",
      "sources": [
        "config/quantitative_research_knowledge.json",
        "contracts/quantitative_research_knowledge.schema.json",
        "AGENTS.md"
      ]
    },
    {
      "path": "docs/roadmap.md",
      "kind": "research_roadmap",
      "sources": [
        "config/research_stages.json",
        "config/signal_policy.json",
        "config/models.json",
        "config/trading-policy.json"
      ]
    },
    {
      "path": "docs/THIRD_PARTY.md",
      "kind": "third_party_policy",
      "sources": [
        "config/third_party.json",
        "config/models.json",
        "config/data_sources.json",
        ".gitmodules"
      ]
    },
    {
      "path": "docs/rule-verification.md",
      "kind": "rule_verification",
      "sources": [
        "config/rule_verification.json"
      ]
    }
  ]
}
