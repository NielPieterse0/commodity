  "prediction": {
    "horizon_trading_sessions": 1,
    "information_cutoff": "after_current_daily_bar_close",
    "calendar": "CME_NYMEX",
    "session_timezone": "America/Chicago",
    "timestamp_storage": "UTC",
    "target_contract_rule": "freeze contract selected at cutoff by existing deterministic roll policy",
    "next_session_contract_substitution_allowed": false
  },
  "target": {
    "name": "next_session_same_contract_garman_klass_variance",
    "unit": "squared_log_return",
    "formula": "0.5*ln(high/low)^2-(2*ln(2)-1)*ln(close/open)^2",
    "epsilon": 1e-12,
    "source": "raw_per_contract_daily_ohlc",
    "availability": "only after the target session raw daily bar is available",
    "row_requirements": [
      "exactly_one_next_session_bar_for_target_contract",
      "finite_positive_open_high_low_close",
      "valid_ohlc_ordering",
      "twenty_prior_same_contract_realized_variance_observations_available_at_cutoff"
    ],
    "failure_policy": "fail_closed_no_row_drop_no_imputation_no_cross_contract_substitution"
  },
  "primary_loss": {
    "name": "qlike",
    "formula": "y/h-log(y/h)-1",
    "epsilon": 1e-12,
    "comparison_direction": "lower_is_better",
    "paired_improvement": "baseline_qlike_minus_challenger_qlike"
  },
  "primary_baseline": {
    "id": "same_contract_rv20_mean",
    "formula": "arithmetic_mean_of_20_most_recent_available_same_contract_garman_klass_variances",
    "fallback_window_allowed": false
  },
  "challenger": {
    "id": "log_har_ols_v1",
    "family": "ordinary_least_squares",
    "fit_intercept": true,
    "response": "log(max(next_session_same_contract_garman_klass_variance,1e-12))",
    "prediction_transform": "max(exp(predicted_log_variance),1e-12)",
    "hyperparameter_tuning": "prohibited",
    "feature_selection": "prohibited",
    "features": [
      "log_rv_d1",
      "log_rv_w5",
      "log_rv_m20"
    ],
    "feature_definitions": {
      "log_rv_d1": "log(max(current_same_contract_garman_klass_variance,1e-12))",
      "log_rv_w5": "log(max(mean(current_and_previous_4_same_contract_garman_klass_variances),1e-12))",
      "log_rv_m20": "log(max(mean(current_and_previous_19_same_contract_garman_klass_variances),1e-12))"
    }
  },
  "walk_forward": {
    "strategy": "expanding",
    "initial_train_rows": 252,
    "refit_every_scored_rows": 5,
    "label_rule": "only_target_bars_already_available_may_enter_training",
